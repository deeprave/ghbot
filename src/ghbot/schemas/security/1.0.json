{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ghbot://schemas/security/1.0.json",
  "title": "ghbot security report 1.0",
  "type": "object",
  "required": [
    "summary",
    "repositories"
  ],
  "properties": {
    "complete": {"type": "boolean"},
    "abort_reason": {"type": ["string", "null"], "enum": ["rate_limited", "task_failed", null]},
    "not_processed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository", "reason"],
        "properties": {
          "repository": {"type": "string"},
          "reason": {"enum": ["rate_limited", "task_failed"]}
        }
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "severity_counts": {
      "type": ["object", "null"],
      "required": ["critical", "high", "medium", "low", "other"],
      "properties": {
        "critical": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "reason": {"enum": ["not_found", "forbidden", "disabled", "error"]},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "repos_scanned",
        "repos_with_issues",
        "dependabot_alerts",
        "dependabot_alerts_by_severity",
        "code_scanning_alerts",
        "code_scanning_alerts_by_severity",
        "secret_scanning_alerts",
        "dependabot_open_pull_requests",
        "dependabot_ready_pull_requests"
      ],
      "properties": {
        "repos_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "repos_with_issues": {
          "type": "integer",
          "minimum": 0
        },
        "dependabot_alerts": {
          "$ref": "#/$defs/count"
        },
        "dependabot_alerts_by_severity": {
          "$ref": "#/$defs/severity_counts"
        },
        "code_scanning_alerts": {
          "$ref": "#/$defs/count"
        },
        "code_scanning_alerts_by_severity": {
          "$ref": "#/$defs/severity_counts"
        },
        "secret_scanning_alerts": {
          "$ref": "#/$defs/count"
        },
        "dependabot_open_pull_requests": {
          "$ref": "#/$defs/count"
        },
        "dependabot_ready_pull_requests": {
          "$ref": "#/$defs/count"
        }
      },
      "additionalProperties": true
    },
    "repository": {
      "description": "Security metrics may be absent when an unexpected failed scan produced no value; null means attempted but unavailable, and zero means fetched with no findings.",
      "type": "object",
      "required": [
        "owner",
        "repo",
        "repository"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "status": {"enum": ["success", "partial", "failed", "skipped"]},
        "reason": {"enum": ["not_found", "forbidden", "archived", "error"]},
        "unavailable": {"$ref": "#/$defs/unavailable"},
        "dependabot_alerts": {
          "$ref": "#/$defs/count"
        },
        "dependabot_alerts_by_severity": {
          "$ref": "#/$defs/severity_counts"
        },
        "code_scanning_alerts": {
          "$ref": "#/$defs/count"
        },
        "code_scanning_alerts_by_severity": {
          "$ref": "#/$defs/severity_counts"
        },
        "secret_scanning_alerts": {
          "$ref": "#/$defs/count"
        },
        "dependabot_open_pull_requests": {
          "$ref": "#/$defs/count"
        },
        "dependabot_ready_pull_requests": {
          "$ref": "#/$defs/count"
        }
      },
      "additionalProperties": true
    }
  }
}
